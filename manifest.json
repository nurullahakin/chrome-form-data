{
    "manifest_version": 3,
    "name": "Chrome Form Data",
    "version": "1.0.0",
    "description": "A simple Chrome extension",
    "icons": {
        "16": "icons/16x16.png",
        "32": "icons/32x32.png",
        "48": "icons/48x48.png",
        "128": "icons/128x128.png"
    },
    "action": {
        "default_icon": {
            "16": "icons/16x16.png",
            "32": "icons/32x32.png",
            "48": "icons/48x48.png",
            "128": "icons/128x128.png"
        },
        "default_popup": "popup.html",
        "default_title": "Chrome Form Data"
    },
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}